    <string name="protocol_unverified_title">Watch protocol not verified</string>
    <string name="protocol_unverified_body">The Jupiter R2 vendor protocol is not publicly documented, so this app does not send any proprietary commands. Standard Bluetooth services (Heart Rate 0x180D, Battery 0x180F) are used only if the watch exposes them. Use the GATT inspector to see what your watch exposes.</string>

    <string name="watchfaces_title">Watch faces</string>
    <string name="watchfaces_body">Installing watch faces needs the vendor transfer protocol, which is not verified for the Jupiter R2. Watch faces can only be changed on the watch itself or in the official Fastrack app.</string>
    <string name="calling_title">Bluetooth calling</string>
    <string name="calling_body">Bluetooth calling on the Jupiter R2 uses the classic Bluetooth audio link, which you pair in Android Bluetooth settings. This app cannot enable it.</string>
    <string name="open_bt_settings">Open Bluetooth settings</string>

    <string name="aod_title">Always-On Display</string>
    <string name="aod_unsupported_body">The Jupiter R2 has a 1.38\" TFT (LCD) screen. Published specifications list no Always-On Display for it, and no AOD command is documented, so the controls are disabled. Nothing is simulated.</string>

    <string name="notif_title">Notifications</string>
    <string name="notif_body">Allow notification access so calls and app alerts can be read on this phone. They are stored locally and are not forwarded to the watch until the watch command is verified.</string>
